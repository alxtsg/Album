{
  "name": "album",
  "version": "6.0.1",
  "description": "Static album page generation tool.",
  "homepage": "https://bitbucket.org/alxtsg/album/",
  "license": "BSD-3-Clause",
  "author": "Alex TSANG <alextsang@live.com>",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org:alxtsg/album.git"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "copy-env": "copyfiles src/.env.template dist",
    "copy-package-json": "copyfiles \"package*.json\" dist",
    "copy-template": "copyfiles src/template.mustache dist",
    "copy-test-data": "copyfiles \"src/tests/data/*\" dist",
    "build-test": "tsc && npm run copy-env && npm run copy-package-json && npm run copy-template && npm run copy-test-data",
    "build-release": "tsc && npm run copy-env && npm run copy-package-json && npm run copy-template",
    "pretest": "node src/tests/setup.js",
    "test": "mocha --recursive --exclude src/tests/setup.js \"src/tests/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/mocha": "10.0.10",
    "@types/mustache": "4.2.6",
    "@types/node": "24.19.2",
    "copyfiles": "2.4.1",
    "mocha": "12.0.3",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "imports": {
    "#app/*": "./*"
  }
}
