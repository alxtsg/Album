{
  "name": "album",
  "version": "6.0.1",
  "description": "Static album page generation tool.",
  "homepage": "https://bitbucket.org/alxtsg/album/",
  "license": "BSD-3-Clause",
  "author": "Alex TSANG <alextsang@live.com>",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org:alxtsg/album.git"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "copy-env": "cpy --flat src/.env.template dist",
    "copy-package-json": "cpy \"package*.json\" dist",
    "copy-template": "cpy src/template.mustache dist",
    "copy-test-data": "cpy \"src/tests/data\" dist",
    "build-test": "tsc && npm run copy-env && npm run copy-package-json && npm run copy-template && npm run copy-test-data",
    "build-release": "tsc && npm run copy-env && npm run copy-package-json && npm run copy-template",
    "test": "node src/tests/setup.js && node --test"
  },
  "dependencies": {
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.6",
    "@types/mustache": "4.2.6",
    "@types/node": "24.19.2",
    "cpy-cli": "7.0.0",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "imports": {
    "#app/*": "./*"
  }
}
